{
  "name": "keeperhub-intent-agent",
  "version": "1.0.0",
  "description": "Natural-language agent that executes real onchain transfers via KeeperHub (DoraHacks Agents Onchain Hackathon)",
  "type": "module",
  "bin": {
    "kh-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "agent": "tsx src/cli.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "viem": "^2.33.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
